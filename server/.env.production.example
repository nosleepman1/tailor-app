# ============================================
# TailleurPro — Production Configuration
# ============================================
APP_NAME="TailleurPro API"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_URL=https://api.tailleurpro.com
APP_FRONTEND_URL=https://tailleurpro.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# ============================================
# PostgreSQL Database (Production)
# ============================================
DB_CONNECTION=pgsql
DB_HOST=db # or your managed database host
DB_PORT=5432
DB_DATABASE=tailor_production
DB_USERNAME=postgres
DB_PASSWORD=your_ultra_secure_postgres_password
POSTGRES_DB=tailor_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_ultra_secure_postgres_password

# ============================================
# Redis Cache & Queues (Production)
# ============================================
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_ultra_secure_redis_password

# ============================================
# Super Admin Initial Configuration
# ============================================
SUPER_ADMIN_NAME="Super Administrateur"
SUPER_ADMIN_EMAIL=abdallahdiouf.dev@gmail.com
SUPER_ADMIN_PASSWORD=Khoudia1970
SUPER_ADMIN_PHONE=771234567

# ============================================
# PayDunya Payment Gateway (Live)
# ============================================
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=your_live_master_key
PAYDUNYA_PUBLIC_KEY=your_live_public_key
PAYDUNYA_PRIVATE_KEY=your_live_private_key
PAYDUNYA_TOKEN=your_live_token
PAYDUNYA_WEBHOOK_URL=https://api.tailleurpro.com/api/v2/payments/webhook
PAYDUNYA_RETURN_URL=https://tailleurpro.com/subscription/success
PAYDUNYA_CANCEL_URL=https://tailleurpro.com/subscription/cancel

# ============================================
# Expo Mobile Push Notifications
# ============================================
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ============================================
# Mail Configuration (SMTP)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_or_resend_api_key
MAIL_ENCRYPTION=tls
MAIL_FROM_NAME="TailleurPro"
MAIL_FROM_ADDRESS="no-reply@tailleurpro.com"

# ============================================
# File Storage (S3 / Cloudflare R2 or Local)
# ============================================
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=tailleurpro-media

# ============================================
# Docker Supervisor Container Settings
# ============================================
ENABLE_QUEUE_WORKER=true
ENABLE_SCHEDULER=true
QUEUE_WORKER_PROCS=4
RUN_MIGRATIONS=true
RUN_SEEDERS=false
OPTIMIZE_CACHE=true
